# Copy to .env (never commit it) and fill in what you need.
# Real environment variables always win over this file, so a systemd unit or
# `docker run -e` can override anything here without editing the file.

# ---------------------------------------------------------------- live execution (ccxt)
# The names the config points at are TO_API_KEY / TO_API_SECRET; the CCXT_* aliases are
# accepted too, so a .env written from a generic exchange tutorial still works.
# Live orders are only sent when BOTH keys exist AND config/settings.json has
#   "execution": { "paper": false, "dry_run": false }
TO_API_KEY=
TO_API_SECRET=

# Optional: override the exchange / testnet flag from config/settings.json
# TO_EXCHANGE_ID=bybit
# TO_TESTNET=True

# ---------------------------------------------------------------- state at rest
# Encrypt state/ (positions, bar locks, ledger) with Fernet. Off by default: a plaintext
# state directory stays readable by the engine, and turning this on later is safe — files
# are re-encrypted as they are rewritten.
#
# Generate a key once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TO_STATE_ENCRYPTION_KEY=
#
# Or use a passphrase instead (stretched with scrypt; convenient for a VPS, weaker than a
# full-entropy key):
# TO_STATE_PASSPHRASE=

# ---------------------------------------------------------------- out-of-band alerts
# Telegram bot token; the chat id lives in config/settings.json -> alerts.telegram.chat_id.
# Both are needed for out-of-band alerts AND for the control bot (/help, /status, /panic,
# and the Approve/Reject buttons). The chat id is an owner allowlist: only that chat may
# command the bot. `trading-office doctor` reports presence only.
# The alias TELEGRAM_BOT_TOKEN (also TELEGRAM_TOKEN / TG_TOKEN) is accepted, so a token
# copied from a guide that uses that name still works.
TO_TELEGRAM_TOKEN=

# ---------------------------------------------------------------- Exness (CFD / gold)
# The Trader API (docs: exness-api.com) needs an account opened on the EXNESS platform;
# MT4/MT5 sub-accounts cannot issue keys. The private key is Ed25519: keep it in a file
# outside the repo. `trading-office exness --connect` is read-only and never trades.
TO_EXNESS_API_KEY=
TO_EXNESS_PRIVATE_KEY=
TO_EXNESS_PRIVATE_KEY_PATH=
TO_EXNESS_ACCOUNT_ID=
TO_EXNESS_GATEWAY_HOST=

# ---------------------------------------------------------------- config location
# TO_CONFIG=/etc/trading-office/settings.json

# ---------------------------------------------------------------- NOT supported
# MT5_LOGIN / MT5_PASSWORD / MT5_SERVER are ignored on purpose: MetaTrader 5 is
# Windows-only and this project has no MT5 execution path. `doctor` and /api/security
# report them as ignored instead of pretending to use them.
